# Google AI Studio / Gemini API Key
# Replace with your actual Gemini API key (e.g. AIzaSy... or OAuth token)
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini Generation Model
# Recommended: gemini-3.8-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL="gemini-3.8-flash"

# Gemini Embedding Model
# Recommended: gemini-embedding-001 or gemini-embedding-2-preview
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Target Document File Path (default: nila.pdf in project root)
DOCUMENT_PATH="nila.pdf"
